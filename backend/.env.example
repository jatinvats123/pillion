# Copy to backend/.env and fill in. Never commit .env.

# --- Agora (Console → your project) ---
# App Certificate must be enabled. Conversational AI and Signaling (RTM) must be enabled for the project.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# RTC uid the agent joins with. Must differ from rider uids (backend gives riders 100000–899999).
AGORA_AGENT_UID=1000
# Agora REST API routing region: US, EU, AP
AGORA_AREA=AP

# --- LLM: Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- LLM ---
# openai = Agora-managed OpenAI, no key needed (default; ~1 s to first token in tests)
# gemini = Gemini with GEMINI_API_KEY (24–37 s to first token in our Sep 2026 tests)
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.6

# --- Speech stack ---
# sarvam  = Sarvam STT + TTS (Indian accents, Hindi/English/Hinglish). Needs SARVAM_API_KEY.
# managed = Agora-managed Deepgram nova-3 STT + MiniMax TTS. No extra key; Hindi quality not verified.
VOICE_STACK=sarvam

# Sarvam (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
# STT language: "unknown" = auto-detect per utterance (Hindi/English switching). Or hi-IN / en-IN.
SARVAM_STT_LANGUAGE=unknown
# TTS voice language is fixed per session. hi-IN reads Devanagari Hindi and English words.
SARVAM_TTS_LANGUAGE=hi-IN
# Agora uses Sarvam bulbul:v3 voices (the v2 names in Agora's docs, e.g. anushka, are rejected).
# Female e.g.: priya, neha, ritu, kavya, simran, ishita, shreya · Male e.g.: aditya, rahul, rohan, amit, kabir
SARVAM_TTS_SPEAKER=priya
# Speaking speed (1.0 = normal). Slightly brisk suits short answers on the road.
SARVAM_TTS_PACE=1.08

# Managed fallback (VOICE_STACK=managed)
DEEPGRAM_LANGUAGE=multi
MINIMAX_VOICE_ID=English_captivating_female1

# Language hint for Agora turn detection (hi-IN, en-IN, en-US, ...)
TURN_DETECTION_LANGUAGE=hi-IN

# --- Tools (Agora ConvoAI custom tools call this backend over public HTTPS) ---
# Each session: run `cloudflared tunnel --protocol http2 --url http://localhost:3000`, paste the
# printed https://....trycloudflare.com URL here and restart the backend. Rides can't start without it.
# (http2: QUIC/UDP 7844 is partly blocked on some networks; cloudflared's precheck fails on it.)
PUBLIC_BASE_URL=
# /agent/start, /agent/stop and /debug/latency refuse requests that come through the tunnel (anyone
# with the URL could otherwise start agents on your Agora account). Set true only while testing the
# phone on mobile data through the tunnel.
ALLOW_PUBLIC_RIDE_START=false
# Filler words play once the LLM has been silent this long (ms). 1500 ≈ tool calls only.
FILLER_WAIT_MS=1500

# --- Maps (next-drop ETA and nearby places) ---
# geoapify = free tier, no card (https://myprojects.geoapify.com). No live traffic: ETAs use its
#            "approximated" typical-traffic model.
# google   = Routes API + Places API (New) with live traffic. Cloud Console: enable both APIs,
#            billing on, restrict the key to them.
MAPS_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Weather (getWeather tool). Optional: without a key (or if OpenWeather fails) Open-Meteo is used. ---
# Free key: https://home.openweathermap.org/api_keys (a new key can take up to 2 h to work).
OPENWEATHER_API_KEY=

# --- Jev (TypeSafe AI) intent routing. Optional: with it off, the LLM routes alone. ---
JEV_ENABLED=true
JEV_API_KEY=
# jevai.org community proxy (jev_... keys); it rejects "jev-latest", so leave JEV_MODEL empty.
# Official TypeSafe API: JEV_URL=https://api.typesafe.ai/v1/systemone and JEV_MODEL=jev-latest.
JEV_URL=https://www.jevai.org/api/v1/decisions
JEV_MODEL=
# Jev runs alongside the LLM and never delays it; only the SMS/call "yes" check waits for it.
# It's skipped for a turn if it hasn't answered in this time (~0.5–0.8 s seen from India).
JEV_TIMEOUT_MS=1500
# Minimum intent confidence before Pillion prefetches the data the LLM is about to ask for.
JEV_MIN_CONFIDENCE=0.5

# --- Public deployment (Render etc.; see limits.js) ---
# Set = public mode: /agent/start, /agent/stop and /order/geocode need this key in the X-Pillion-Key
# header, from anywhere (the release app sends it: PILLION_APP_KEY in android/local.properties).
# Empty = local mode (laptop / Wi-Fi / tunnel rules above). A speed bump, not a secret: it ships in
# the APK. Make one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_KEY=
# Kill switch: false refuses new rides at once (running rides go on until they end).
RIDES_ENABLED=true
# The voice stops this many minutes into a ride (the agent says so); crash detection and SOS keep
# running on the phone, Live Guardian links keep working. 0 = no limit.
MAX_RIDE_MINUTES=10
# Daily caps (reset at midnight IST, and on a restart); then the app says "Demo limit reached".
MAX_RIDES_PER_DAY=40
MAX_AGENT_MINUTES_PER_DAY=300
MAX_CONCURRENT_RIDES=5
# Ride starts per IP and per device in 10 minutes (Retry counts too).
MAX_STARTS_PER_10_MIN=4
# /debug/think, /debug/history, /debug/latency. Default: on in local mode, off in public mode.
# DEBUG_ROUTES=

# --- Server ---
PORT=3000
# 127.0.0.1 is enough for the emulator (10.0.2.2), adb reverse and cloudflared. 0.0.0.0 also lets
# the phone reach the backend over Wi-Fi (scripts/phone.ps1 builds that route in), which keeps
# working when wireless adb drops, e.g. while the phone sleeps. Agent start/stop still refuses
# public addresses and the tunnel.
HOST=0.0.0.0
# Rider token + agent lifetime in seconds (max 86400).
TOKEN_EXPIRY_SECONDS=14400

# --- Live Guardian (SOS SMS link: family hears, talks to and locates the rider) ---
# Needs PUBLIC_BASE_URL (the link points at the tunnel). false = SOS SMS without a link, /g/* shows
# "expired", the agent never hands over. Links live 2 h, in memory (a backend restart ends them).
GUARDIAN_ENABLED=false

# --- Answer calls by voice (the rider also turns it on in the app's Settings) ---
# The phone reports a ringing call (caller kind and name, never the number); Pillion asks whether to
# answer it. false = calls pause Pillion as before.
CALL_ANSWER_ENABLED=false
