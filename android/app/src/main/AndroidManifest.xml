<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <!-- SMS/call and GPS actions degrade to a spoken error on devices without them. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Order scan by camera (printed bills, another phone's screen); sharing a screenshot needs none. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bluetooth earphones: legacy permission up to Android 11, runtime permission from Android 12. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Keeps the mic live while the phone is locked in a pocket or mount during a ride. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice actions: next-drop ETA and nearby places need the rider's position. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Message / call the customer after a spoken yes; call state pauses Pillion during calls. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Crash alert: shown over the lock screen (Android 14+ lets the rider turn this off; the
         app then shows a setup card), vibration, and a CPU kept awake only while an alert or SOS
         is running (time-limited). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Crash detection must keep running with the screen locked; the setup card asks for the exemption. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Order scan: asked only when the rider taps Camera. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- On-device text-to-speech (safety alerts without internet) needs to see the TTS engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".PillionApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pillion">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Share → Pillion: scan order" from the delivery app: reads the screenshot, then opens
             the ride screen. No window; never kept in the sharing app's task or in recents. -->
        <activity
            android:name=".ShareOrderActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_label"
            android:noHistory="true"
            android:theme="@style/Theme.Pillion.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Crash / SOS alert: over the lock screen, in its own task so nothing else of the app
             shows there. -->
        <activity
            android:name=".ui.SafetyAlertActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="app.pillion.alert" />

        <service
            android:name=".ride.RideService"
            android:exported="false"
            android:foregroundServiceType="microphone|location" />

        <receiver
            android:name=".safety.SafetyActionReceiver"
            android:exported="false" />
    </application>

</manifest>
