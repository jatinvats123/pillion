<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme before Compose draws; dark to match the app and avoid a white flash. -->
    <style name="Theme.Pillion" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- "Share → Pillion": no window of its own; it hands the image over and brings the ride screen forward. -->
    <style name="Theme.Pillion.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>
</resources>
